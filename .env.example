# X (Twitter) developer app credentials — Keys & Tokens tab, console.x.com
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_BEARER_TOKEN=
# User-context tokens for the BOT ACCOUNT itself (Read+Write app permissions required).
# Generate these from the bot account's own login, not your personal account.
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Bot behavior
POLL_INTERVAL_SECONDS=30
MAX_REPLIES_PER_DAY=200
MAX_REPLIES_PER_AUTHOR_PER_DAY=5
# Only reply to X-verified accounts (blue/business/government) — skip verified_type=="none"
REQUIRE_VERIFIED_AUTHOR=true
# Only reply to accounts whose profile location looks US-based. Best-effort and
# spoofable — X exposes no account-country field. See README "US-only gate".
# Blank profile location counts as non-US, so this WILL turn away real US users.
REQUIRE_US_AUTHOR=true
DB_PATH=./data/bot.db
