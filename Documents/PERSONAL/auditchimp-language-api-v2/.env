# Audio Processing Configuration
QUANTIZATION=true
WHISPER_MODEL=large-v2
WHISPER_DEVICE=auto  # auto, cuda, cpu - auto detects GPU availability
WHISPER_COMPUTE_TYPE=int8_float16

# Diarization Configuration
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_USE_GPU=true
NEMO_MODEL=nvidia/speakerverification_en_titanet_large

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database Configuration
DATABASE_URL=sqlite:///./auditchimp.db

# Processing Configuration
MAX_FILE_SIZE=100000000  # 100MB
SUPPORTED_FORMATS=mp3,wav,flac,m4a,ogg,webm
CHUNK_SIZE=30  # seconds for audio chunks
MAX_CONCURRENT_JOBS=3

# Model Cache Configuration
MODEL_CACHE_DIR=./models
MAX_CACHE_SIZE=10GB

# Hugging Face Configuration (for Windows compatibility)
HF_HOME=./models
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_ENABLE_HF_TRANSFER=0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/auditchimp.log
